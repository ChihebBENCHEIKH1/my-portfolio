    "fortawesome": "^0.0.1-security",
    "framer-motion": "^11.0.24",
    "gh-pages": "^6.1.1",
    "gsap": "^3.12.5",
    "hover.css": "^2.3.2",
    "ionicons": "^7.3.1",
    "magnific-popup": "^1.1.0",
    "owl.carousel": "^2.3.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.183.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
