    "prebuild:cyberpunk": "node scripts/generate-project-images.mjs",
    "postbuild:cyberpunk": "node scripts/prerender.mjs",
    "postbuild": "node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:profile": "node --test scripts/verify-profile.test.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "deploy": "node scripts/publish-portfolio.mjs",
    "deploy:stage": "node scripts/publish-portfolio.mjs --stage-only"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
